rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read and write their own document and sub-collections
    // (results, recommendations, notifications, transactions).
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read, write: if isOwner();

      match /{collection}/{docId} {
        allow read: if isOwner();
        allow write: if isOwner() && collection != 'transactions';
      }

      // Payment records are write-once: they cannot be edited or deleted.
      match /transactions/{paymentId} {
        allow create: if isOwner()
          && request.resource.data.id == paymentId
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.status == 'succeeded';
      }
    }
  }
}
